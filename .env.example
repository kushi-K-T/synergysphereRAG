APP_NAME=SynergySphere
APP_ENV=development
DEBUG=true

# Host & Server
HOST=0.0.0.0
PORT=8000

# Local AI (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b
OLLAMA_TIMEOUT=60.0

# Hugging Face Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ChromaDB Vector Store
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=synergysphere_documents

# RAG Configuration
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5

# External AI Provider (Optional)
EXTERNAL_AI_ENABLED=false
EXTERNAL_AI_PROVIDER=openai
EXTERNAL_AI_API_KEY=
EXTERNAL_AI_MODEL=gpt-4o-mini
EXTERNAL_AI_BASE_URL=https://api.openai.com/v1
EXTERNAL_AI_TIMEOUT=30.0

# Local Metadata Database (SQLite)
DATABASE_URL=sqlite:///./data/synergysphere.db

# Model Context Protocol (MCP) Integration
MCP_ENABLED=false
MCP_SERVER_URL=

# Security & Constraints
MAX_UPLOAD_SIZE_MB=10
SENSITIVE_KEYWORDS=confidential,internal,project,architecture,secret,private,budget,proprietary,financial,database,client,ssn,credential,salary,api_key